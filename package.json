{
  "name": "score-pilot",
  "private": true,
  "version": "0.0.0",
  "description": "Score Pilot JavaScript workspaces",
  "workspaces": [
    "apps/web",
    "packages/engine-ts",
    "packages/api-client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @score-pilot/web",
