# Copy to .env and adjust. Never commit .env.

APP_ENV=local
LOG_LEVEL=info

# Local cluster started by database/local-db.sh (trust auth, no password).
DATABASE_URL=postgresql+asyncpg://teslimsulaiman@127.0.0.1:55439/scorepilot
DATABASE_SCHEMA=stackprep

REDIS_URL=redis://127.0.0.1:6379/0

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# AI help (ADR-0009). Runtime is NOT the cheap model: the coach has to stay inside a reviewed
# solution and refuse to reveal an answer early, and those rules rest on the model. Revisit
# once the refusal behaviour has been measured; AI_DAILY_CALLS_PER_STUDENT caps the cost.
OPENAI_API_KEY=
AI_RUNTIME_MODEL=gpt-4o
AI_BATCH_MODEL=gpt-4o
AI_DAILY_CALLS_PER_STUDENT=20
